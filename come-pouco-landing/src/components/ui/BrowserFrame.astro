---
export interface Props {
  /** Texto da barra de URL (decorativo) */
  url?: string;
  /** Tema da chrome do browser */
  theme?: 'light' | 'dark' | 'auto';
  /** Aspect ratio do conteúdo */
  aspect?: '16/10' | '4/3' | '16/9';
  class?: string;
}

const {
  url = 'app.auralinks.com.br',
  theme = 'auto',
  aspect = '16/10',
  class: extraClass = ''
} = Astro.props;

const themeClass = theme === 'auto' ? '' : theme === 'dark' ? 'dark' : 'light';

const aspectMap: Record<NonNullable<Props['aspect']>, string> = {
  '16/10': 'aspect-[16/10]',
  '4/3': 'aspect-[4/3]',
  '16/9': 'aspect-video'
};
---

<div
  class:list={[
    'overflow-hidden rounded-[var(--cp-radius-lg)] border border-[var(--cp-color-border)] bg-[var(--cp-color-surface)] shadow-[var(--cp-shadow-xl)]',
    themeClass,
    extraClass
  ]}
>
  <div
    class="flex items-center gap-2 border-b border-[var(--cp-color-border)] bg-[var(--cp-color-muted)] px-4 py-3"
  >
    <div class="flex gap-1.5">
      <span class="block h-3 w-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
      <span class="block h-3 w-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
      <span class="block h-3 w-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
    </div>
    <div
      class="ml-3 flex-1 truncate rounded-[var(--cp-radius-sm)] bg-[var(--cp-color-surface)] px-3 py-1 text-[12px] text-[var(--cp-color-muted-foreground)]"
    >
      {url}
    </div>
  </div>
  <div class:list={['relative bg-[var(--cp-color-surface)]', aspectMap[aspect]]}>
    <slot />
  </div>
</div>
