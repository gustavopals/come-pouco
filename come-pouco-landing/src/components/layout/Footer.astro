  LinkedIn:
    'M4 3.5C4 2.7 4.7 2 5.5 2S7 2.7 7 3.5 6.3 5 5.5 5 4 4.3 4 3.5ZM4.5 6.5h2V20h-2V6.5Zm5 0h2v1.9c.6-1.1 1.9-2.1 3.6-2.1 3.4 0 4.4 2 4.4 4.6V20h-2v-7.2c0-1.7-.6-2.9-2.3-2.9-1.5 0-2.4 1-2.4 2.9V20h-2V6.5Z',
  GitHub:
    'M12 2C6.5 2 2 6.5 2 12c0 4.4 2.9 8.2 6.8 9.5.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5C19.1 20.2 22 16.4 22 12c0-5.5-4.5-10-10-10Z'
};
---

<footer class="cp-hairline border-t bg-[var(--cp-color-muted)]">
  <Container size="page" class="py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4 md:gap-12">
      <div class="col-span-2">
        <Logo />
        <p
          class="mt-4 max-w-xs text-[14px] leading-relaxed text-[var(--cp-color-muted-foreground)]"
        >
          Gestão profissional de afiliados Shopee — com módulo público pra sua audiência converter
          sozinha.
        </p>
        <ul class="mt-6 flex gap-2">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--cp-radius-md)] border border-[var(--cp-color-border)] bg-[var(--cp-color-surface)] text-[var(--cp-color-muted-foreground)] transition-colors hover:text-[var(--cp-color-primary)]"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={socialIcons[item.label] ?? ''} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        footerSections.map((section) => (
          <div>
            <h3 class="text-[13px] font-semibold uppercase tracking-wider text-[var(--cp-color-muted-foreground)]">
              {section.heading}
            </h3>
            <ul class="mt-4 flex flex-col gap-3">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-[14px] text-[var(--cp-color-foreground)] hover:text-[var(--cp-color-primary)]"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="cp-hairline mt-12 flex flex-col items-start justify-between gap-3 border-t pt-6 text-[13px] text-[var(--cp-color-muted-foreground)] md:flex-row md:items-center"
    >
      <p>© {year} auralinks. Feito no Brasil.</p>
      <p>Construído com Astro + Tailwind. Privacy-first.</p>
    </div>
  </Container>
</footer>
