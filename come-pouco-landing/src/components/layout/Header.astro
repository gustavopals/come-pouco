---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Logo from '@components/brand/Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import { primaryNav, getAppUrl } from '@lib/navigation';
---

<header
  data-cp-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background,border,backdrop-filter] duration-200 ease-[var(--cp-ease-standard)]"
>
  <Container size="page" class="flex h-[68px] items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Navegação principal" class="hidden items-center gap-1 lg:flex">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="rounded-[var(--cp-radius-sm)] px-3 py-2 text-[14px] font-medium text-[var(--cp-color-muted-foreground)] transition-colors hover:bg-[var(--cp-color-muted)] hover:text-[var(--cp-color-foreground)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden lg:flex lg:items-center lg:gap-2">
        <ThemeToggle />
        <Button href={getAppUrl('/login')} variant="ghost" size="sm">Entrar</Button>
        <Button
          href={getAppUrl('/register')}
          variant="primary"
          size="sm"
          dataEvent="cta_click_header_register"
        >
          Começar grátis
        </Button>
      </div>
      <MobileNav />
    </div>
  </Container>
</header>

<script>
  function init() {
    const header = document.querySelector<HTMLElement>('[data-cp-header]');
    if (!header) return;
    const onScroll = () => {
      if (window.scrollY > 8) {
        header.classList.add(
          'bg-[var(--cp-color-surface)]/80',
          'border-[var(--cp-color-border)]',
          'backdrop-blur-md'
        );
      } else {
        header.classList.remove(
          'bg-[var(--cp-color-surface)]/80',
          'border-[var(--cp-color-border)]',
          'backdrop-blur-md'
        );
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>
