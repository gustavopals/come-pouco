---
export interface Props {
  size?: number;
  /** `color` usa gradiente da marca; `mono` segue `currentColor` */
  variant?: 'color' | 'mono';
  class?: string;
  ariaLabel?: string;
}

const { size = 28, variant = 'color', class: extraClass = '', ariaLabel } = Astro.props;
const id = `cp-mark-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  role={ariaLabel ? 'img' : 'presentation'}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : 'true'}
  class={extraClass}
  fill="none"
>
  {
    variant === 'color' && (
      <defs>
        <linearGradient id={id} x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="var(--cp-mkt-hero-grad-start)" />
          <stop offset="0.55" stop-color="var(--cp-mkt-hero-grad-mid)" />
          <stop offset="1" stop-color="var(--cp-mkt-hero-grad-end)" />
        </linearGradient>
      </defs>
    )
  }
  <path
    d="M16 3 L28 9 L28 23 L16 29 L4 23 L4 9 Z"
    stroke={variant === 'color' ? `url(#${id})` : 'currentColor'}
    stroke-width="2.5"
    stroke-linejoin="round"></path>
  <circle cx="16" cy="16" r="4.5" fill={variant === 'color' ? `url(#${id})` : 'currentColor'}
  ></circle>
</svg>
