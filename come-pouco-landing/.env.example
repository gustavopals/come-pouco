# URL pública do site (sem barra final)
PUBLIC_SITE_URL=https://auralinks.com.br

# Domínio do Plausible / Umami (sem protocolo)
PUBLIC_PLAUSIBLE_DOMAIN=auralinks.com.br

# Script src do provider de analytics (ex.: https://plausible.io/js/script.js)
PUBLIC_ANALYTICS_SCRIPT=

# URL do endpoint público de leads (precisa do prefixo PUBLIC_ pois é usado no cliente)
PUBLIC_LEAD_API_URL=https://api.auralinks.com.br/api/public/leads

# URL da app autenticada (CTAs "Entrar" → /login, "Começar grátis" → /register)
PUBLIC_APP_URL=https://app.auralinks.com.br
SENTRY_DSN_LANDING=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE_LANDING=0.1
SENTRY_ORG=
SENTRY_PROJECT_LANDING=
SENTRY_AUTH_TOKEN=
