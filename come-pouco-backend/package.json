{
  "name": "come-pouco-backend",
  "version": "1.0.0",
  "description": "API do projeto Come Pouco",
  "main": "dist/server.js",
  "scripts": {
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postbuild": "npm run sentry:sourcemaps",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "cd .. && ./node_modules/.bin/eslint come-pouco-backend --cache --cache-location node_modules/.cache/eslint-backend",
    "lint:fix": "cd .. && ./node_modules/.bin/eslint come-pouco-backend --fix --cache --cache-location node_modules/.cache/eslint-backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude tests/integration/**/*.spec.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run tests/integration",
    "test:cov": "vitest run --coverage",
    "test:coverage": "npm run test:cov",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "secrets:migrate": "node scripts/encrypt-existing-secrets.js",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.js",
    "auth:check": "node scripts/auth-hardening-check.js",
    "auth:smoke": "node scripts/auth-smoke-test.js",
    "smoke:postdeploy": "node scripts/post-deploy-smoke.js",
    "email:configure-smtp": "node scripts/configure-email-smtp.js",
    "email:test-smtp": "node scripts/test-email-smtp.js"
  },
  "keywords": [
    "express",
    "postgres",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.923.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@sentry/cli": "^3.4.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "prisma": "^7.4.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7",
    "vitest-mock-extended": "^4.0.0"
  }
}
