{
  "name": "come-pouco-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run sentry:env",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "npm run sentry:env",
    "build": "ng build",
    "postbuild": "npm run sentry:sourcemaps",
    "check": "ng build --configuration development --no-progress",
    "lint": "cd .. && ./node_modules/.bin/eslint come-pouco-frontend --cache --cache-location node_modules/.cache/eslint-frontend",
    "lint:fix": "cd .. && ./node_modules/.bin/eslint come-pouco-frontend --fix --cache --cache-location node_modules/.cache/eslint-frontend",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:cov": "ng test --watch=false --coverage --coverage-reporters=text --coverage-reporters=lcov --coverage-reporters=json-summary",
    "sentry:env": "node scripts/write-sentry-env.mjs",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/material": "^21.2.12",
    "@angular/platform-browser": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@fontsource-variable/manrope": "^5.2.8",
    "@lucide/angular": "^1.16.0",
    "@sentry/angular": "^10.53.1",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@sentry/cli": "^3.4.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^19.2.1",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^28.0.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
