OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:latest
OPENOBSERVE_PORT=5080
OPENOBSERVE_ROOT_USER_EMAIL=root@example.com
OPENOBSERVE_ROOT_USER_PASSWORD=Complexpass#123
OPENOBSERVE_ORG=default

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=24h

ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
ALERTMANAGER_PORT=9093
ALERT_DISCORD_WEBHOOK_FILE=./infra/alertmanager/secrets/discord_webhook_url.example

BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.27.0
BLACKBOX_EXPORTER_PORT=9115

# O prometheus.yml versionado usa estes valores de dev:
# - backend alvo: host.docker.internal:3000
# - metricas backend: metrics / metrics-dev-change-me
# - OpenObserve remote_write: root@example.com / Complexpass#123
# - Discord webhook: infra/alertmanager/secrets/discord_webhook_url.example
#
# Em producao/Coolify, gere ou edite infra/openobserve/prometheus.yml
# com as credenciais reais antes de subir a stack.
