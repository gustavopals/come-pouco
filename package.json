{
  "name": "come-pouco",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do projeto Come Pouco",
  "scripts": {
    "postinstall": "concurrently -n backend,frontend,landing -c blue,green,magenta --kill-others-on-fail \"npm:install:backend\" \"npm:install:frontend\" \"npm:install:landing\"",
    "install:backend": "npm --prefix come-pouco-backend install",
    "install:frontend": "npm --prefix come-pouco-frontend install",
    "install:landing": "npm --prefix come-pouco-landing install",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "obs:up": "docker compose -f docker-compose.observability.yml --env-file infra/openobserve/.env.example up -d",
    "obs:down": "docker compose -f docker-compose.observability.yml --env-file infra/openobserve/.env.example down",
    "obs:logs": "docker compose -f docker-compose.observability.yml --env-file infra/openobserve/.env.example logs -f",
    "dev": "concurrently -n backend,frontend -c blue,green --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:all": "concurrently -n backend,frontend,landing -c blue,green,magenta --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:landing\"",
    "dev:backend": "npm --prefix come-pouco-backend run dev",
    "dev:frontend": "npm --prefix come-pouco-frontend start",
    "dev:landing": "npm --prefix come-pouco-landing run dev",
    "build": "concurrently -n backend,frontend,landing -c blue,green,magenta --kill-others-on-fail \"npm:build:backend\" \"npm:build:frontend\" \"npm:build:landing\" && npm run prisma:deploy",
    "build:ci": "concurrently -n backend,frontend,landing -c blue,green,magenta --kill-others-on-fail \"npm:build:backend\" \"npm:build:frontend\" \"npm:build:landing\"",
    "build:backend": "npm --prefix come-pouco-backend run build",
    "build:frontend": "npm --prefix come-pouco-frontend run build",
    "build:landing": "npm --prefix come-pouco-landing run build",
    "lint": "npm run lint:eslint && npm run format:check",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint-root",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint-root",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm run audit:prod:root && npm run audit:prod:backend && npm run audit:prod:frontend && npm run audit:prod:landing",
    "audit:prod:root": "npm audit --omit=dev --audit-level=critical",
    "audit:prod:backend": "npm --prefix come-pouco-backend audit --omit=dev --audit-level=critical",
    "audit:prod:frontend": "npm --prefix come-pouco-frontend audit --omit=dev --audit-level=critical",
    "audit:prod:landing": "npm --prefix come-pouco-landing audit --omit=dev --audit-level=critical",
    "lefthook:install": "lefthook install",
    "prepare": "lefthook install",
    "prisma:deploy": "npm --prefix come-pouco-backend run prisma:deploy",
    "check": "concurrently -n backend,frontend,landing -c blue,green,magenta --kill-others-on-fail \"npm:check:backend\" \"npm:check:frontend\" \"npm:check:landing\"",
    "check:backend": "npm --prefix come-pouco-backend run check",
    "check:frontend": "npm --prefix come-pouco-frontend run check",
    "check:landing": "npm --prefix come-pouco-landing run check",
    "test:backend": "npm --prefix come-pouco-backend run test:unit",
    "test:backend:cov": "npm --prefix come-pouco-backend run test:cov",
    "test:frontend": "npm --prefix come-pouco-frontend test -- --watch=false",
    "test:frontend:cov": "npm --prefix come-pouco-frontend run test:cov",
    "test:landing": "npm --prefix come-pouco-landing test",
    "test:landing:cov": "npm --prefix come-pouco-landing run test:cov",
    "coverage:badges": "node scripts/coverage/write-badges.mjs",
    "coverage:comment": "node scripts/coverage/comment-pr.mjs",
    "smoke:postdeploy": "npm --prefix come-pouco-backend run smoke:postdeploy",
    "e2e": "npm run e2e:deps && npm run e2e:test",
    "e2e:test": "playwright test",
    "e2e:headed": "npm run e2e:deps && playwright test --headed",
    "e2e:ui": "npm run e2e:deps && playwright test --ui",
    "e2e:list": "playwright test --list",
    "e2e:install": "playwright install",
    "e2e:deps": "docker compose up -d postgres mailpit",
    "e2e:server:backend": "PORT=3001 APP_ENV=development LOG_LEVEL=warn LOG_FORMAT=json SHOPEE_MOCK=true SHOPEE_MOCK_FAILURE_PATTERN=e2e-force-fallback SHORTLINK_MOCK_TARGET_URL=https://shopee.com.br/product/10001/20002 PUBLIC_APP_URL=http://127.0.0.1:4200 CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200 PUBLIC_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200 npm --prefix come-pouco-backend run prisma:deploy && PORT=3001 APP_ENV=development LOG_LEVEL=warn LOG_FORMAT=json SHOPEE_MOCK=true SHOPEE_MOCK_FAILURE_PATTERN=e2e-force-fallback SHORTLINK_MOCK_TARGET_URL=https://shopee.com.br/product/10001/20002 PUBLIC_APP_URL=http://127.0.0.1:4200 CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200 PUBLIC_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200 npm --prefix come-pouco-backend run dev",
    "e2e:server:frontend": "npm --prefix come-pouco-frontend start -- --host 127.0.0.1 --port 4200",
    "e2e:server:landing": "npm --prefix come-pouco-landing run dev -- --host 127.0.0.1 --port 4321"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "astro-eslint-parser": "^1.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "lefthook": "^2.1.8",
    "otplib": "^13.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
